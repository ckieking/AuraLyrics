        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後處於焦點外的歌詞將呈現模糊效果，聚焦當前播放行；關閉可降低發熱及耗電。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies a blur effect to non-focused lyrics to highlight current line. Disabling reduces power consumption."
          }
        }
